  "description": "Choose Google Fonts in the studio and serve them from your own site, for EmDash and GitDash.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digital-Defiance/gitdash-plugins.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://github.com/Digital-Defiance/gitdash-plugins/tree/main/packages/fonts#readme",
  "keywords": [
    "emdash",
    "gitdash",
    "astro",
    "fonts",
    "google-fonts"
  ],
  "bin": {
